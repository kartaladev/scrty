{
  "description": "scrty OpenID Provider, conformance OP (test/cmd/conformanceop)",
  "alias": "scrty",
  "server": {
    "discoveryUrl": "https://op:9443/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "client",
    "client_secret": "conformance-secret-for-client-one-0000"
  },
  "client2": {
    "client_id": "client2",
    "client_secret": "conformance-secret-for-client-two-0000"
  },
  "client_secret_post": {
    "client_id": "client-post",
    "client_secret": "conformance-secret-for-client-post-000"
  },
  "browser": [
    {
      "match": "https://op:9443/oauth2/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "https://op:9443/login*",
          "commands": [
            [
              "text",
              "name",
              "username",
              "conformance",
              "optional"
            ],
            [
              "text",
              "name",
              "password",
              "conformance-password",
              "optional"
            ],
            [
              "click",
              "class",
              "login-submit"
            ]
          ]
        },
        {
          "task": "Consent",
          "optional": true,
          "match": "https://op:9443/consent*",
          "commands": [
            [
              "click",
              "class",
              "login-submit"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    },
    {
      "match": "https://op:9443/oauth2/logout*",
      "tasks": [
        {
          "task": "Choose logout option",
          "optional": true,
          "match": "https://op:9443/logout*",
          "commands": [
            [
              "click",
              "css",
              "button[autofocus]"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/post*"
        }
      ]
    }
  ],
  "override": {
    "oidcc-backchannel-rp-initiated-logout": {
      "client": {
        "client_id": "client-bcl",
        "client_secret": "conformance-secret-for-client-bcl-0000"
      }
    },
    "oidcc-prompt-login": {
      "browser": [
        {
          "comment": "updates the placeholder during the second authorization",
          "match": "https://op:9443/oauth2/authorize*",
          "tasks": [
            {
              "task": "Login",
              "optional": true,
              "match": "https://op:9443/login*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign-in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "name",
                  "username",
                  "conformance",
                  "optional"
                ],
                [
                  "text",
                  "name",
                  "password",
                  "conformance-password",
                  "optional"
                ],
                [
                  "click",
                  "class",
                  "login-submit"
                ]
              ]
            },
            {
              "task": "Consent",
              "optional": true,
              "match": "https://op:9443/consent*",
              "commands": [
                [
                  "click",
                  "class",
                  "login-submit"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
